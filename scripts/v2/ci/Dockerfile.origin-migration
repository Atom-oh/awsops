# Build from the repository root with --platform linux/arm64.
FROM node:22-alpine
RUN apk add --no-cache aws-cli
WORKDIR /app
COPY scripts/v2/package.json scripts/v2/package-lock.json ./scripts/v2/
RUN npm ci --prefix scripts/v2 --omit=dev --ignore-scripts --no-audit --no-fund
COPY scripts/v2/migrate.mjs scripts/v2/migrate-core.mjs scripts/v2/migrate-tls.mjs scripts/v2/migration-context.mjs ./scripts/v2/
COPY scripts/v2/ci/origin-migration-entry.mjs ./scripts/v2/ci/
COPY scripts/v2/eks/rds-ca-bundle.pem ./scripts/v2/eks/
COPY terraform/v2/foundation/migrations ./terraform/v2/foundation/migrations
COPY web/package.json ./web/package.json
ARG SOURCE_COMMIT
RUN test "${#SOURCE_COMMIT}" = 40 && \
    ! printf '%s' "$SOURCE_COMMIT" | grep -q '[^0-9a-f]' && \
    printf '%s\n' "$SOURCE_COMMIT" > .migration-source && chmod 444 .migration-source
USER node
CMD ["node", "scripts/v2/ci/origin-migration-entry.mjs"]
