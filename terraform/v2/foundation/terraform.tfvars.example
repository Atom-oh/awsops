domain_name      = "v2.example.com"
hosted_zone_name = "example.com"
# vpc_cidr       = "10.20.0.0/16"   # uncomment to override

# Optional Steampipe AWS API limiter and inventory-sync Lambda backpressure overrides.
# steampipe_aws_max_concurrency      = 4
# steampipe_aws_bucket_size          = 4
# steampipe_aws_fill_rate            = 2
# steampipe_sync_reserved_concurrency = 4
# inventory_stale_after_minutes       = 30

# Optional operator CI access bootstrap; no backend/state or CloudFront access.
# Requires the existing account GitHub OIDC provider with STS audience.
# github_actions_enabled = false
# Keep this empty for private Fargate; only its dedicated task role reads DB secrets.
# github_actions_migration_secret_arns = []
# Private executor is separately gated; null creates no resources.
# github_actions_migration = {
#   subnets               = ["<EXISTING_PRIVATE_SUBNET_ID>"]
#   security_group        = "<EXISTING_WEB_SERVICE_SECURITY_GROUP_ID>"
#   master_secret_arn     = "<OWNED_AURORA_MANAGED_SECRET_ARN>"
#   sql_reader_secret_arn = null # or the exact owned reader secret ARN
#   kms_key_arns          = ["<OWNED_MASTER_SECRET_KMS_KEY_ARN>"]
# }
# For approved secrets using customer-managed encryption keys, supply full key ARNs.
# github_actions_secret_kms_key_arns = []
